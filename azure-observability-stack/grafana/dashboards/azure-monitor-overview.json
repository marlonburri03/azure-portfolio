{
  "__inputs": [
    {
      "name": "DS_AZURE_MONITOR",
      "label": "Azure Monitor",
      "description": "Azure Monitor datasource provisioned by Azure Managed Grafana",
      "type": "datasource",
      "pluginId": "grafana-azure-monitor-datasource",
      "pluginName": "Azure Monitor"
    }
  ],
  "__requires": [
    { "type": "grafana", "id": "grafana", "name": "Grafana", "version": "9.0.0" },
    { "type": "datasource", "id": "grafana-azure-monitor-datasource", "name": "Azure Monitor", "version": "1.0.0" }
  ],
  "title": "Azure Monitor Overview",
  "uid": "azure-monitor-overview",
  "description": "Unified overview of Azure infrastructure health: VM availability, AKS workloads, App Service errors, and resource cost trends.",
  "tags": ["azure", "monitoring", "infrastructure"],
  "timezone": "utc",
  "editable": true,
  "schemaVersion": 38,
  "version": 1,
  "time": { "from": "now-6h", "to": "now" },
  "refresh": "5m",
  "templating": {
    "list": [
      {
        "name": "subscription",
        "type": "query",
        "datasource": "${DS_AZURE_MONITOR}",
        "query": { "queryType": "Azure Subscriptions" },
        "refresh": 1,
        "multi": false,
        "includeAll": false
      },
      {
        "name": "resourceGroup",
        "type": "query",
        "datasource": "${DS_AZURE_MONITOR}",
        "query": {
          "queryType": "Azure Resource Groups",
          "subscription": "$subscription"
        },
        "refresh": 1,
        "multi": true,
        "includeAll": true
      }
    ]
  },
  "panels": [
    {
      "title": "VM Availability — Online vs Offline",
      "type": "stat",
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 0 },
      "datasource": "${DS_AZURE_MONITOR}",
      "targets": [
        {
          "queryType": "Azure Log Analytics",
          "azureLogAnalytics": {
            "query": "Heartbeat\n| where TimeGenerated > ago(15m)\n| summarize LastHeartbeat = max(TimeGenerated) by Computer\n| extend Status = iff(LastHeartbeat < ago(10m), 0, 1)\n| summarize OnlineVMs = sumif(1, Status == 1), OfflineVMs = sumif(1, Status == 0)",
            "resultFormat": "table"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        }
      }
    },
    {
      "title": "VM CPU Utilization — Fleet Average",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 6, "y": 0 },
      "datasource": "${DS_AZURE_MONITOR}",
      "targets": [
        {
          "queryType": "Azure Log Analytics",
          "azureLogAnalytics": {
            "query": "Perf\n| where ObjectName == 'Processor' and CounterName == '% Processor Time' and InstanceName == '_Total'\n| summarize AvgCPU = avg(CounterValue), P95CPU = percentile(CounterValue, 95) by bin(TimeGenerated, 5m)\n| render timechart",
            "resultFormat": "time_series"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 70 },
              { "color": "red", "value": 90 }
            ]
          }
        }
      }
    },
    {
      "title": "AKS Running Pod Count by Cluster",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": "${DS_AZURE_MONITOR}",
      "targets": [
        {
          "queryType": "Azure Log Analytics",
          "azureLogAnalytics": {
            "query": "KubePodInventory\n| where PodStatus == 'Running'\n| summarize PodCount = dcount(PodUid) by ClusterName, bin(TimeGenerated, 5m)\n| render timechart",
            "resultFormat": "time_series"
          }
        }
      ]
    },
    {
      "title": "AKS Pod Restarts (Last Hour)",
      "type": "table",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": "${DS_AZURE_MONITOR}",
      "targets": [
        {
          "queryType": "Azure Log Analytics",
          "azureLogAnalytics": {
            "query": "KubePodInventory\n| where TimeGenerated > ago(1h) and PodRestartCount > 0\n| summarize MaxRestarts = max(PodRestartCount), MinRestarts = min(PodRestartCount) by PodName, Namespace, ClusterName\n| extend RestartDelta = MaxRestarts - MinRestarts\n| where RestartDelta >= 2\n| order by RestartDelta desc\n| take 15\n| project ClusterName, Namespace, PodName, RestartDelta",
            "resultFormat": "table"
          }
        }
      ]
    },
    {
      "title": "App Service HTTP 5xx Error Rate",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "datasource": "${DS_AZURE_MONITOR}",
      "targets": [
        {
          "queryType": "Azure Log Analytics",
          "azureLogAnalytics": {
            "query": "AppServiceHTTPLogs\n| summarize Total = count(), Errors = countif(ScStatus >= 500) by CsHost, bin(TimeGenerated, 5m)\n| extend ErrorRate = round(100.0 * Errors / Total, 2)\n| project TimeGenerated, CsHost, ErrorRate\n| render timechart",
            "resultFormat": "time_series"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "red", "value": 5 }
            ]
          }
        }
      }
    },
    {
      "title": "VM Memory — Available MBytes (Fleet)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "datasource": "${DS_AZURE_MONITOR}",
      "targets": [
        {
          "queryType": "Azure Log Analytics",
          "azureLogAnalytics": {
            "query": "Perf\n| where ObjectName == 'Memory' and CounterName == 'Available MBytes'\n| summarize AvailMB = avg(CounterValue) by Computer, bin(TimeGenerated, 5m)\n| render timechart",
            "resultFormat": "time_series"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "decmbytes"
        }
      }
    }
  ]
}
